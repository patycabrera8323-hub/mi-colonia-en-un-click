rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── SEGURIDAD Y LOGICA COMUN ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserAdmin() {
      return isSignedIn() &&
             request.auth.token.email in [
               'searmoco@gmail.com',
               'patycabrera8323@gmail.com',
               'jesus.israel@gmail.com',
               'jicr109@gmail.com'
             ];
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthorizedUser() {
      return isUserAdmin() || (isSignedIn() && getUserData().isAuthorized == true);
    }

    // ─── REGLAS POR COLECCIÓN ────────────────────────────────────────────────

    // 1. Perfiles de usuario (Admin Terminal y Clientes)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isUserAdmin();
      allow delete: if isUserAdmin();
    }

    // 2. Repartidores (Drivers)
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId) || isUserAdmin();
    }

    // 3. Productos (Catálogos)
    match /products/{productId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isAuthorizedUser() && getUserData().canEdit == true);
    }

    // 4. Pedidos y Órdenes
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isUserAdmin();
    }

    // 5. Estado de apertura del negocio
    match /storeState/{businessId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isAuthorizedUser() && getUserData().canEdit == true);
    }

    // 6. Mensajes de Chat con Gigi
    match /chat_messages/{messageId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if isUserAdmin();
    }

    // 7. Negocios y Restaurantes
    match /negocios/{negocioId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    // 8. Reportes y Reservaciones del Vecindario
    match /reports/{reportId} {
      allow read, create: if true;
      allow update, delete: if isUserAdmin();
    }

    // 9. Pedidos históricos del bot principal
    match /pedidos/{pedidoId} {
      allow read, create: if true;
      allow update, delete: if isUserAdmin();
    }

    // Bloqueo global de seguridad por defecto para nuevas colecciones
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
