rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCIONES REUTILIZABLES ─────────────────────────────────────────────

    // ¿El usuario tiene sesión iniciada con Firebase Auth?
    function isSignedIn() {
      return request.auth != null;
    }

    // ¿El usuario es el administrador del proyecto?
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email in [
               'patycabrera8323@gmail.com',
               'jesus.israel@gmail.com',
               'jicr109@gmail.com'
             ] &&
             request.auth.token.email_verified == true;
    }

    // ¿El usuario es el dueño del documento?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validación de reportes / reservaciones
    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'description', 'address', 'status', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 256 &&
             data.description is string && data.description.size() <= 2000 &&
             data.address is string && data.address.size() <= 500 &&
             data.status in ['pending', 'in_progress', 'resolved'] &&
             (data.createdAt is timestamp || data.createdAt is number);
    }

    // Validación de mensajes de chat
    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'text', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 256 &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 4000 &&
             (data.createdAt is timestamp || data.createdAt is number);
    }

    // ─── REGLAS POR COLECCIÓN ────────────────────────────────────────────────

    // 1. Perfiles de usuario
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Mensajes de Chat con Gigi
    //    Permite que cualquier usuario (incluso sin sesión Firebase real,
    //    como el usuario de demostración "Jesus Israel") pueda guardar mensajes.
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if true;    // Abierto para desarrollo; restringe después
      allow update: if false;   // Los mensajes no se editan
      allow delete: if isAdmin();
    }

    // 3. Directorio de Restaurantes de la Colonia (sólo lectura pública)
    match /negocios/{negocioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Reportes y Reservaciones del Vecindario
    //    Lectura pública + escritura abierta para la app (datos de reservas)
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;    // Reservaciones creadas desde el bot sin auth
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Pedidos del vecino
    match /pedidos/{pedidoId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Bloqueo global por defecto (todo lo demás es privado)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
